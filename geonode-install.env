# Edite os valores abaixo. Sem espaços em volta do =. Não é executado como shell.
GEONODE_PROJECT_REF=5.1.0
GEONODE_VERSION=5.1.0
DJANGO_BOOTSTRAP_VERSION=5.2
SYSTEM_USER=geonode
PROJECT_NAME=curso_geonode
INSTALL_DIR=/opt/geonode/curso_geonode
HOSTNAME=geonode.seudominio.com.br
ENABLE_HTTPS=true
LETSENCRYPT_EMAIL=contato@seudominio.com.br
# Opcional: IPv4 público da VM para conferir o DNS antes da instalação.
SERVER_IPV4=
GEOSERVER_XMS=2G
GEOSERVER_XMX=4G
UWSGI_PROCESSES=4
CELERY_WORKERS=2
WAIT_SECONDS=1800

# Detectar alterações no workspace geonode e executar manage.py updatelayers.
UPDATE_LAYERS_ENABLED=true
# Intervalos válidos: 1, 2, 3, 4, 6, 8, 12 ou 24 horas (horário do servidor).
UPDATE_LAYERS_INTERVAL_HOURS=1

# Mínimo de RAM em GiB. Aceita decimais com ponto; 0 desativa a checagem.
# 14 mantém margem para VMs comercializadas como 16 GB.
# Não ajusta automaticamente GeoServer, uWSGI ou Celery.
MIN_RAM_GB=14

# Espaço livre mínimo em GiB no destino. 0 desativa a checagem.
# O consumo real depende de imagens, cache de build e dados enviados.
MIN_DISK_GB=30
